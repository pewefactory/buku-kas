  /* ------------------------------------------------------------------ */
  /*  Peristiwa                                                           */
  /* ------------------------------------------------------------------ */
  const AKSI = {
    tab: (el) => gantiTab(el.dataset.v),
    tambah: () => bukaForm(null),
    tutup: () => { S.form = null; tutupLapisan(); },
    segarkan: () => { muatData(false).then(() => kirimTunda(true)); },
    'kirim-tunda': () => kirimTunda(true),
    periode: (el) => {
      const k = el.dataset.v;
      if (k === 'kustom') { if (S.periode.k !== 'kustom') { const r = hitungRentang('bulan'); S.periode = { k: 'kustom', dari: r.dari, sampai: U.hariIni() }; } bukaLapisan('kustom'); return; }
      S.periode = { k, dari: '', sampai: '' }; simpan.taruh('bk_periode', S.periode); renderIsi(true);
    },
