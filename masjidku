      '<div class="medan"><div class="medan-judul">Catatan <span class="opsional">opsional</span></div><input id="f-cat" class="teks" maxlength="300" placeholder="Mis. makan siang, infaq Jumat" value="' + esc(f.cat) + '" enterkeyhint="done" autocomplete="off"></div>' +
      (f.galatUmum ? '<div class="galat-umum" role="alert">' + esc(f.galatUmum) + '</div>' : '') +
