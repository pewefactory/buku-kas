  function tutupDialog() { const d = $('#dialog-hapus'); if (d) d.remove(); }

  async function hapusTx(tx) {
    const tombol = $('#dialog-hapus [data-act="ya-hapus"]');
    if (tombol) { tombol.disabled = true; tombol.innerHTML = '<span class="spin"></span> Menghapus…'; }
    try {
      if (tx.tunda) {
        S.pending = S.pending.filter((x) => x.idKlien !== tx.idKlien); simpanPending(); S.rev++;
      } else {
        await api('hapus', { tipe: tx.tipe, baris: tx.r, semula: { d: tx.d, k: tx.k, n: tx.n, c: tx.c } });
        const daftar = tx.tipe === 'in' ? S.server.masuk : S.server.keluar;
        S.server[tx.tipe === 'in' ? 'masuk' : 'keluar'] = daftar.filter((t) => t.r !== tx.r).map((t) => (t.r > tx.r ? Object.assign({}, t, { r: t.r - 1 }) : t));
        S.rev++; simpanCache();
      }
      tutupDialog(); S.form = null; tutupLapisan(); renderSemuaData();
      toast('Transaksi dihapus dari spreadsheet', 'ok');
      if (!tx.tunda) muatData(true);
    } catch (e) {
      tutupDialog(); toast(e.pesan, 'err', 6000);
