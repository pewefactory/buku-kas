  const navItem = (k, label) => '<button class="nav-item" data-act="tab" data-v="' + k + '" data-tab="' + k + '">' + ikon(k) + '<span>' + label + '</span></button>';

  function render() {
    const root = $('#root');
    if (!S.token) { root.innerHTML = viewMasuk(); return; }
