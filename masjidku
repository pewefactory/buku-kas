  function renderNav() {
    $$('.nav-item').forEach((b) => { const on = b.dataset.tab === S.tab; b.classList.toggle('on', on); b.setAttribute('aria-current', on ? 'page' : 'false'); });
  }

  function renderStatus() {
    const btn = $('#btn-segar'); if (btn) btn.classList.toggle('berputar', S.sync.memuat);
    const pr = $('#progres'); if (pr) pr.classList.toggle('aktif', S.sync.memuat);
    const b = $('#banner'); if (!b) return;
    const n = S.pending.length, off = !navigator.onLine;
    b.innerHTML = n ? '<button class="banner" data-act="kirim-tunda">' + ikon('awan') + '<span>' + n + ' transaksi belum terkirim · ' + (off ? 'menunggu koneksi' : 'ketuk untuk kirim') + '</span></button>'
      : off ? '<div class="banner info">' + ikon('awan') + '<span>Tanpa koneksi. Yang tampil adalah salinan terakhir.</span></div>' : '';
  }

  function gantiTab(t) {
    if (S.tab === t) { window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
    S.tab = t; renderIsi(true); renderNav();
    const isi = $('#isi'); isi.classList.remove('ganti'); void isi.offsetWidth; isi.classList.add('ganti');
    window.scrollTo(0, 0);
