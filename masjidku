  function renderForm() { if (S.lapisan === 'form') { const sk = $('.lembar'); const y = sk ? sk.scrollTop : 0; renderLapisan(); const baru = $('.lembar'); if (baru) baru.scrollTop = y; } }

  function bacaForm() {
    const f = S.form; if (!f) return;
    const n = $('#f-nominal'), c = $('#f-cat'), t = $('#f-tgl'), k = $('#f-kat');
    if (n) f.nominal = n.value.replace(/\D/g, '').replace(/^0+/, '').slice(0, 13);
    if (c) f.cat = c.value;
    if (t && t.value) f.tgl = t.value;
    if (k) f.kat = k.value;
  }

  function setNominal(digits) {
    S.form.nominal = digits;
    const n = $('#f-nominal'); if (n) n.value = digits ? ribuan(Number(digits)) : '';
    const w = $('.nominal'); if (w) w.classList.remove('salah');
  }

  function validasiForm() {
    const f = S.form; bacaForm(); f.galat = {};
    const n = Number(f.nominal || 0);
    if (!f.nominal) f.galat.nominal = 'Nominal wajib diisi.';
    else if (!(n > 0)) f.galat.nominal = 'Nominal harus lebih dari 0.';
    else if (n > 1e12) f.galat.nominal = 'Nominal terlalu besar.';
    if (!f.kat.trim()) f.galat.kat = 'Pilih atau ketik kategori.';
    if (!/^\d{4}-\d{2}-\d{2}$/.test(f.tgl) || isNaN(Date.parse(f.tgl))) f.galat.tgl = 'Tanggal tidak valid.';
    return Object.keys(f.galat).length === 0;
  }

  async function simpanForm() {
    const f = S.form; if (!f || f.menyimpan) return;
    if (!validasiForm()) {
      renderForm();
      const pertama = $('.galat'); if (pertama) pertama.scrollIntoView({ block: 'center', behavior: 'smooth' });
      const n = $('.nominal.salah input'); if (n) n.focus();
      return;
    }
    const tx = { tipe: f.tipe, d: f.tgl, k: f.kat.trim().replace(/\s+/g, ' '), n: Number(f.nominal), c: f.cat.trim() };
    if (!f.edit) { tutupLapisan(); tambahTransaksi(tx); return; }

    f.menyimpan = true; f.galatUmum = ''; renderForm();
    const asli = f.tx;
    try {
      if (asli.tunda) {
        const it = S.pending.find((x) => x.idKlien === asli.idKlien);
        if (it) Object.assign(it, { d: tx.d, k: tx.k, n: tx.n, c: tx.c });
        simpanPending(); S.rev++;
      } else {
        const r = await api('ubah', { tipe: tx.tipe, baris: asli.r, semula: { d: asli.d, k: asli.k, n: asli.n, c: asli.c }, tanggal: tx.d, kategori: tx.k, nominal: tx.n, catatan: tx.c });
        upsertServer(tx.tipe, r.tx); S.rev++; simpanCache();
      }
      S.form = null; tutupLapisan(); renderSemuaData(); toast('Perubahan tersimpan di spreadsheet', 'ok');
    } catch (e) {
      f.menyimpan = false; f.galatUmum = e.pesan; renderForm();
      if (e.kode === 'KONFLIK') muatData(true);
    }
  }

  /* ---- Hapus ---- */
  function mintaHapus(tx) {
    tutupDialog();
    const d = document.createElement('div');
    d.id = 'dialog-hapus'; d.className = 'dialog';
    d.innerHTML = '<div class="tirai" data-act="batal-hapus"></div><div class="kotak-dialog" role="alertdialog" aria-modal="true" aria-labelledby="dh-judul">' +
      '<h3 id="dh-judul">Hapus transaksi ini?</h3><div class="dh-rincian"><b>' + esc(tx.k) + '</b><span>' + (tx.tipe === 'in' ? '+' : '−') + rp(tx.n) + '</span><small>' + U.tglPanjang(tx.d) + (tx.c ? ' · ' + esc(tx.c) : '') + '</small></div>' +
      '<p>Baris ini akan dihapus dari spreadsheet. Tindakan ini tidak bisa dibatalkan.</p><div class="dh-aksi"><button class="btn" data-act="batal-hapus">Batal</button><button class="btn bahaya-isi" data-act="ya-hapus">Hapus</button></div></div>';
    d.dataset.id = tx.id;
    document.body.appendChild(d);
    const b = $('.btn', d); if (b) b.focus();
