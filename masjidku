  function filterRiwayat() {
    const f = S.riwayat, t = U.hariIni();
    let dari = '', sampai = '9999-12-31';
    if (f.tgl === 'hariini') { dari = t; sampai = t; }
    else if (f.tgl === '7hari') { dari = U.tambahHari(t, -6); sampai = t; }
    else if (f.tgl === 'bulanini') { dari = U.awalBulan(t); sampai = U.akhirBulan(t); }
    else if (f.tgl === 'bulanlalu') { const a = U.geserBulan(U.awalBulan(t), -1); dari = a; sampai = U.akhirBulan(a); }
    else if (f.tgl === 'pilih') { dari = f.dari || ''; sampai = f.sampai || '9999-12-31'; if (dari && sampai < dari) { const x = dari; dari = sampai; sampai = x; } }
    const q = f.cari.trim().toLowerCase();
    const qAngka = q.replace(/[.\s]/g, '').replace(/^rp/, '');
    return semua().filter((t2) => {
      if (f.jenis !== 'semua' && t2.tipe !== f.jenis) return false;
      if (f.kat && kunciKat(t2.k) !== f.kat) return false;
      if (dari && t2.d < dari) return false;
      if (t2.d > sampai) return false;
      if (q) {
        const jerami = (t2.k + ' ' + t2.c + ' ' + U.tglPanjang(t2.d) + ' ' + U.HARI[U.dariIso(t2.d).getDay()]).toLowerCase();
        if (jerami.indexOf(q) < 0 && !(qAngka && /^\d+$/.test(qAngka) && String(Math.round(t2.n)).indexOf(qAngka) >= 0)) return false;
      }
      return true;
    }).sort(urutTerbaru);
  }

