      if (!a || !b) { toast('Isi tanggal awal dan akhir.', 'err'); return; }
      if (a > b) { const x = a; a = b; b = x; }
      S.periode = { k: 'kustom', dari: a, sampai: b }; simpan.taruh('bk_periode', S.periode);
      tutupLapisan(); renderIsi(true);
    },
    tren: (el) => { S.tren = el.dataset.v; renderIsi(true); },
    'fokus-kat': (el) => fokusDonat(Number(el.dataset.i)),
    jenis: (el) => { S.riwayat.jenis = el.dataset.v; S.riwayat.tampil = 60; renderIsi(true); },
    lagi: () => { S.riwayat.tampil += 60; renderRiwayatDaftar(); },
    'reset-filter': () => { S.riwayat = { cari: '', jenis: 'semua', kat: '', tgl: 'semua', dari: '', sampai: '', tampil: 60 }; renderIsi(true); },
    buka: (el) => { const t = semua().find((x) => x.id === el.dataset.id); if (t) bukaForm(t); },
    tipe: (el) => {
      bacaForm(); const f = S.form; if (f.edit || f.tipe === el.dataset.v) return;
      f.tipe = el.dataset.v; f.kat = simpan.ambil('bk_kat_' + f.tipe, ''); f.katBebas = false; f.galat = {}; renderForm();
    },
    kat: (el) => { bacaForm(); S.form.kat = el.dataset.v; S.form.katBebas = false; S.form.galat.kat = ''; renderForm(); },
    'kat-bebas': () => { bacaForm(); S.form.katBebas = true; renderForm(); const k = $('#f-kat'); if (k) { k.focus(); k.select(); } },
    tgl: (el) => { bacaForm(); S.form.tgl = el.dataset.v; renderForm(); },
    'plus-nominal': (el) => { bacaForm(); setNominal(String(Math.min(1e12, Number(S.form.nominal || 0) + Number(el.dataset.v)))); },
    'kosong-nominal': () => { setNominal(''); const n = $('#f-nominal'); if (n) n.focus(); },
    simpan: () => simpanForm(),
    'minta-hapus': () => { if (S.form && S.form.tx) mintaHapus(S.form.tx); },
    'batal-hapus': () => tutupDialog(),
    'ya-hapus': (el) => { const d = el.closest('#dialog-hapus'); const t = semua().find((x) => x.id === d.dataset.id) || (S.form && S.form.tx); if (t) hapusTx(t); },
    keluar: () => {
      if (S.pending.length) { toast(S.pending.length + ' transaksi belum terkirim. Kirim dulu sebelum keluar.', 'err'); return; }
      keluarAkun();
    },
    'mode-masuk': (el) => { S.modeMasuk = el.dataset.v; S.galatMasuk = ''; render(); const f = $(S.modeMasuk === 'pin' ? '#m-pin' : '#m-user'); if (f) f.focus(); },
    pasang: async () => {
      if (!S.pasang) return;
      S.pasang.prompt(); try { await S.pasang.userChoice; } catch (e) { /* abaikan */ }
      S.pasang = null; renderSemuaData();
    },
    'simpan-api': () => {
      const u = (($('#m-api') || {}).value || '').trim();
      S.apiDraft = u;
      if (!URL_SAH(u)) { S.galatApi = 'Alamat tidak dikenali. Harus diawali https://script.google.com/ dan berakhiran /exec.'; render(); return; }
      S.galatApi = ''; API_URL = u; API_SIAP = true; simpan.taruh('bk_api', u); render();
      const f = $('#m-user'); if (f) f.focus();
    },
    'sembunyi-pasang': () => { S.sembunyiPasang = true; simpan.taruh('bk_sembunyi_pasang', true); renderSemuaData(); }
  };

  document.addEventListener('click', (e) => {
    const el = e.target.closest('[data-act]');
    if (el && AKSI[el.dataset.act]) { e.preventDefault(); AKSI[el.dataset.act](el, e); return; }
    const bar = e.target.closest('[data-bar]');
    if (bar) { const w = bar.closest('[data-chart]'); if (w) pilihBatang(w, Number(bar.dataset.bar)); return; }
    const seg = e.target.closest('[data-donat]');
    if (seg) fokusDonat(Number(seg.dataset.donat));
  });

  document.addEventListener('input', (e) => {
    const t = e.target;
    if (t.id === 'f-nominal') {
      const d = t.value.replace(/\D/g, '').replace(/^0+/, '').slice(0, 13);
      S.form.nominal = d; t.value = d ? ribuan(Number(d)) : '';
      const w = t.closest('.nominal'); if (w) w.classList.remove('salah');
    } else if (t.id === 'cari') {
      S.riwayat.cari = t.value; S.riwayat.tampil = 60; renderRiwayatDaftar();
    } else if (t.id === 'f-kat' && S.form) { S.form.kat = t.value; }
    else if (t.id === 'm-pin' && /^\d{6}$/.test(t.value)) { kirimMasuk(); }
  });

  document.addEventListener('change', (e) => {
    const t = e.target;
    if (t.id === 'f-kat-riw') { S.riwayat.kat = t.value; S.riwayat.tampil = 60; renderRiwayatDaftar(); }
    if (t.id === 'f-tgl-riw') { S.riwayat.tgl = t.value; S.riwayat.tampil = 60; renderIsi(true); }
    if (t.id === 'f-tgl') { bacaForm(); renderForm(); }
    if (t.id === 'f-dari') { S.riwayat.dari = t.value; renderRiwayatDaftar(); }
    if (t.id === 'f-sampai') { S.riwayat.sampai = t.value; renderRiwayatDaftar(); }
  });

  document.addEventListener('submit', (e) => { if (e.target.id === 'form-masuk') { e.preventDefault(); kirimMasuk(); } });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { if ($('#dialog-hapus')) tutupDialog(); else if (S.lapisan) { S.form = null; tutupLapisan(); } }
    if (e.key === 'Enter' && e.target.id === 'f-cat') { e.preventDefault(); simpanForm(); }
  });

  window.addEventListener('online', () => { renderStatus(); if (S.token) { kirimTunda(false).then(() => muatData(true)); } });
  window.addEventListener('offline', renderStatus);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible' || !S.token) return;
    if (S.pending.length) kirimTunda(false);
    if (Date.now() - S.sync.waktu > 2 * 60 * 1000) muatData(true);
    // hari bisa berganti saat aplikasi dibiarkan terbuka
    renderSemuaData();
  });
  window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); S.pasang = e; if (S.token) renderSemuaData(); });
  window.addEventListener('appinstalled', () => { S.pasang = null; renderSemuaData(); });

  /* ------------------------------------------------------------------ */
  /*  Mulai                                                               */
  /* ------------------------------------------------------------------ */
  function mulai() {
    // id unik untuk filter kategori di riwayat (supaya tidak bentrok dengan kolom kategori di formulir)
    document.title = CFG.NAMA_APLIKASI || 'Buku Kas';
    render();
    if (S.token) { muatData(true).then(() => kirimTunda(false)); }
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('sw.js').catch(() => { /* tetap jalan tanpa offline */ }));
    }
  }
  window.__BK = { S, semua, hitungRentang, rentangSebelumnya, ringkasan };   // untuk pengujian
  mulai();
})();

/* Grafik SVG buatan sendiri (tanpa pustaka luar, jadi tetap jalan saat offline). */
(function () {
  const { esc, ringkas, rp } = window.U;

  // Urutan warna kategori: sudah diuji aman untuk buta warna (lihat PANDUAN, bagian desain).
  const WARNA = ['var(--s1)', 'var(--s2)', 'var(--s3)', 'var(--s4)', 'var(--s5)', 'var(--s6)'];
  const WARNA_LAIN = 'var(--s-lain)';

  function nice(v) {
    if (v <= 0) return 1;
    const e = Math.pow(10, Math.floor(Math.log10(v)));
    const f = v / e;
    return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 2.5 ? 2.5 : f <= 5 ? 5 : 10) * e;
  }

  function batang(x, y, w, h, r) {
    r = Math.max(0, Math.min(r, w / 2, h));
    return 'M' + x + ',' + (y + h) + ' V' + (y + r) + ' Q' + x + ',' + y + ' ' + (x + r) + ',' + y +
      ' H' + (x + w - r) + ' Q' + (x + w) + ',' + y + ' ' + (x + w) + ',' + (y + r) + ' V' + (y + h) + ' Z';
  }

  const W = 340, H = 176, KIRI = 40, KANAN = 6, ATAS = 10, BAWAH = 24;
  const PW = W - KIRI - KANAN, PH = H - ATAS - BAWAH;

  function kerangka(maks, n, labelX, aria, isi, rataRata) {
    const ticks = [0, maks / 2, maks];
    let s = '<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="' + esc(aria) + '">';
    ticks.forEach(function (t) {
      const y = ATAS + PH - (t / maks) * PH;
      s += '<line class="grid" x1="' + KIRI + '" x2="' + (W - KANAN) + '" y1="' + y + '" y2="' + y + '"/>' +
        '<text class="sumbu" x="' + (KIRI - 6) + '" y="' + (y + 3.5) + '" text-anchor="end">' + ringkas(t) + '</text>';
    });
    s += isi;
    if (rataRata > 0 && rataRata <= maks) {
      const y = ATAS + PH - (rataRata / maks) * PH;
      s += '<line class="rata" x1="' + KIRI + '" x2="' + (W - KANAN) + '" y1="' + y + '" y2="' + y + '"/>' +
        '<text class="rata-label" x="' + (KIRI + 4) + '" y="' + (y - 5) + '" text-anchor="start">rata-rata ' + ringkas(rataRata) + '</text>';
    }
    labelX.forEach(function (l) {
      s += '<text class="sumbu" x="' + l.x + '" y="' + (H - 7) + '" text-anchor="middle">' + esc(l.t) + '</text>';
    });
    return s + '</svg>';
  }

  function labelJarang(buckets, xTengah) {
    const n = buckets.length, langkah = n <= 8 ? 1 : Math.ceil(n / 6);
    const out = [];
    for (let i = 0; i < n; i += langkah) out.push({ x: xTengah(i), t: buckets[i].label });
    return out;
  }

  /** Batang tunggal. buckets: [{label, nilai}] */
  function batangTunggal(buckets, opsi) {
    opsi = opsi || {};
    const n = buckets.length;
    const maks = nice(Math.max.apply(null, buckets.map(function (b) { return b.nilai; }).concat([1])));
    const slot = PW / n, lebar = Math.min(26, slot * 0.64);
    const xTengah = function (i) { return KIRI + slot * i + slot / 2; };
    let isi = '<g class="bars">';
    buckets.forEach(function (b, i) {
      const h = b.nilai > 0 ? Math.max(2, (b.nilai / maks) * PH) : 0;
      isi += '<g class="bar-g" data-bar="' + i + '">' +
        '<rect class="hit" x="' + (KIRI + slot * i) + '" y="' + ATAS + '" width="' + slot + '" height="' + PH + '"/>' +
        (h ? '<path class="bar" style="fill:' + (opsi.warna || 'var(--keluar)') + '" d="' + batang(xTengah(i) - lebar / 2, ATAS + PH - h, lebar, h, 4) + '"/>' : '') +
        '</g>';
    });
    isi += '</g>';
    return kerangka(maks, n, labelJarang(buckets, xTengah), opsi.aria || 'Grafik batang', isi, opsi.rataRata || 0);
  }

  /** Batang berpasangan (pemasukan vs pengeluaran). buckets: [{label, a, b}] */
  function batangPasangan(buckets, opsi) {
    opsi = opsi || {};
    const n = buckets.length;
    const maks = nice(Math.max.apply(null, buckets.map(function (b) { return Math.max(b.a, b.b); }).concat([1])));
    const slot = PW / n, lebar = Math.min(18, slot * 0.34), celah = 2;
    const xTengah = function (i) { return KIRI + slot * i + slot / 2; };
    let isi = '<g class="bars">';
    buckets.forEach(function (b, i) {
      const ha = b.a > 0 ? Math.max(2, (b.a / maks) * PH) : 0;
      const hb = b.b > 0 ? Math.max(2, (b.b / maks) * PH) : 0;
      const x0 = xTengah(i) - lebar - celah / 2;
      isi += '<g class="bar-g" data-bar="' + i + '">' +
        '<rect class="hit" x="' + (KIRI + slot * i) + '" y="' + ATAS + '" width="' + slot + '" height="' + PH + '"/>' +
        (ha ? '<path class="bar" style="fill:var(--masuk)" d="' + batang(x0, ATAS + PH - ha, lebar, ha, 4) + '"/>' : '') +
        (hb ? '<path class="bar" style="fill:var(--keluar)" d="' + batang(x0 + lebar + celah, ATAS + PH - hb, lebar, hb, 4) + '"/>' : '') +
        '</g>';
    });
    isi += '</g>';
    return kerangka(maks, n, labelJarang(buckets, xTengah), opsi.aria || 'Grafik batang berpasangan', isi, 0);
  }

  /** Donat. items: [{nilai, warna}] */
  function donat(items, total, pusat) {
    const R = 66, SW = 24, C = 2 * Math.PI * R, GAP = items.length > 1 ? 2.5 : 0;
    let s = '<svg class="donat" viewBox="0 0 180 180" role="img" aria-label="Pengeluaran per kategori">' +
      '<g transform="rotate(-90 90 90)"><circle class="donat-latar" cx="90" cy="90" r="' + R + '" stroke-width="' + SW + '"/>';
    let acuan = 0;
    items.forEach(function (it, i) {
      const len = (it.nilai / total) * C;
      const tampak = Math.max(0.5, len - GAP);
      s += '<circle class="donat-seg" data-donat="' + i + '" cx="90" cy="90" r="' + R + '" stroke-width="' + SW + '"' +
        ' style="stroke:' + it.warna + '" stroke-dasharray="' + tampak + ' ' + (C - tampak) + '" stroke-dashoffset="' + (-acuan) + '"/>';
      acuan += len;
    });
    s += '</g><g class="donat-pusat">' + pusat + '</g></svg>';
    return s;
  }

  /** Tabel angka pendamping grafik (untuk pembaca layar & yang lebih suka angka). */
  function tabel(judulKolom, baris) {
    let s = '<details class="tabel-angka"><summary>Lihat angka</summary><table><thead><tr><th></th>' +
      judulKolom.map(function (j) { return '<th>' + esc(j) + '</th>'; }).join('') + '</tr></thead><tbody>';
    baris.forEach(function (r) {
      s += '<tr><th>' + esc(r.label) + '</th>' + r.nilai.map(function (v) { return '<td>' + rp(v) + '</td>'; }).join('') + '</tr>';
    });
    return s + '</tbody></table></details>';
  }

  window.Grafik = { WARNA, WARNA_LAIN, batangTunggal, batangPasangan, donat, tabel };
})();
