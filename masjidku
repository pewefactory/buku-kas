    if (p.k === 'minggu' || p.k === 'hari') {
      const geser = p.k === 'minggu' ? 7 : 1;
      const dari = U.tambahHari(p.dari, -geser);
      return { dari: dari, sampai: U.tambahHari(dari, n - 1) };
    }
    const sampai = U.tambahHari(p.dari, -1);
    return { dari: U.tambahHari(sampai, -(n - 1)), sampai: sampai };
  }

  function ringkasan(dari, sampai) {
    let masuk = 0, keluar = 0, nm = 0, nk = 0;
    semua().forEach((t) => {
      if (t.d < dari || t.d > sampai) return;
      if (t.tipe === 'in') { masuk += t.n; nm++; } else { keluar += t.n; nk++; }
    });
    return { masuk, keluar, saldo: masuk - keluar, nm, nk };
  }

  function agregatKategori(tipe, dari, sampai) {
    const peta = {};
    semua().forEach((t) => {
      if (t.tipe !== tipe) return;
      if (dari && (t.d < dari || t.d > sampai)) return;
      const k = kunciKat(t.k);
      const e = peta[k] || (peta[k] = { kunci: k, nilai: 0, jumlah: 0, ejaan: {} });
      e.nilai += t.n; e.jumlah++; e.ejaan[t.k] = (e.ejaan[t.k] || 0) + 1;
    });
    return Object.keys(peta).map((k) => {
      const e = peta[k];
      e.nama = Object.keys(e.ejaan).sort((a, b) => e.ejaan[b] - e.ejaan[a])[0];
      return e;
    }).sort((a, b) => b.nilai - a.nilai);
  }

  /** Warna kategori tetap per kategori (berdasarkan total sepanjang waktu), tidak berubah saat periode diganti. */
  function warnaKategori(daftarPeriode) {
    const semuaWaktu = agregatKategori('out').map((e) => e.kunci);
    const peta = {}, terpakai = {};
    semuaWaktu.slice(0, G.WARNA.length).forEach((k, i) => { peta[k] = G.WARNA[i]; });
    const bebas = G.WARNA.filter((w) => Object.keys(peta).every((k) => peta[k] !== w));
    daftarPeriode.slice(0, G.WARNA.length).forEach((e) => {
      if (!peta[e.kunci] && bebas.length) peta[e.kunci] = bebas.shift();
    });
    return (k) => peta[k] || G.WARNA_LAIN;
  }

  let memoBulan = { rev: -1, peta: {} };
  function perBulan() {
    if (memoBulan.rev === S.rev) return memoBulan.peta;
    const peta = {};
    semua().forEach((t) => {
      const b = t.d.slice(0, 7);
      const e = peta[b] || (peta[b] = { in: 0, out: 0 });
      e[t.tipe] += t.n;
    });
    memoBulan = { rev: S.rev, peta };
    return peta;
  }

  /** Daftar kategori untuk chip formulir: yang paling sering dipakai lebih dulu, lalu saran bawaan. */
  function daftarKategori(tipe, wajibAda) {
    const bawaan = (tipe === 'out' ? CFG.KATEGORI_KELUAR : CFG.KATEGORI_MASUK) || [];
    const data = agregatKategori(tipe);
    const hitung = {}, nama = {};
    data.forEach((e) => { hitung[e.kunci] = e.jumlah; nama[e.kunci] = e.nama; });
    const kunci = [];
    bawaan.concat(data.map((e) => e.nama)).forEach((n) => {
      const k = kunciKat(n);
      if (k && kunci.indexOf(k) < 0) { kunci.push(k); if (!nama[k]) nama[k] = n; }
    });
    const urut = kunci.map((k, i) => ({ k, i })).sort((a, b) => (hitung[b.k] || 0) - (hitung[a.k] || 0) || a.i - b.i).map((x) => x.k);
    const semuaNama = urut.map((k) => nama[k]);
    let chip = semuaNama.slice(0, 8);
    if (wajibAda && chip.map(kunciKat).indexOf(kunciKat(wajibAda)) < 0) chip = [wajibAda].concat(chip.slice(0, 7));
    return { chip, semua: semuaNama };
  }

  /* ------------------------------------------------------------------ */
  /*  Jaringan                                                            */
  /* ------------------------------------------------------------------ */
  async function api(aksi, isi) {
    if (!API_SIAP) throw { kode: 'KONFIG', pesan: 'Alamat Apps Script belum diisi di config.js.' };
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 30000);
    let res;
    try {
      res = await fetch(API_URL, {
        method: 'POST', redirect: 'follow', signal: ctl.signal,
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },   // "text/plain" menghindari pemeriksaan CORS yang tidak didukung Apps Script
        body: JSON.stringify(Object.assign({ aksi, token: S.token }, isi || {}))
      });
    } catch (e) {
      throw { kode: 'JARINGAN', pesan: e && e.name === 'AbortError' ? 'Server terlalu lama merespons.' : 'Tidak ada koneksi internet.' };
    } finally { clearTimeout(timer); }
    let j;
    try { j = await res.json(); } catch (e) {
      throw { kode: 'RESPON', pesan: 'Balasan server tidak terbaca. Periksa alamat API dan pengaturan deploy (akses: Siapa saja).' };
    }
    if (!j.ok) {
      if (j.kode === 'AUTH' && aksi !== 'login') sesiBerakhir();
      throw { kode: j.kode, pesan: j.pesan || 'Terjadi kesalahan.' };
    }
    return j;
  }

  function sesiBerakhir() {
    if (!S.token) return;
    S.token = ''; simpan.hapus('bk_token');
    S.galatMasuk = 'Sesi berakhir. Silakan masuk lagi.';
    tutupLapisan(); render();
  }

  async function muatData(senyap) {
    if (S.sync.memuat || !S.token) return;
    S.sync.memuat = true; S.sync.galat = null; renderStatus();
    try {
      const r = await api('data');
      S.server = { masuk: r.masuk.tx, keluar: r.keluar.tx };
      S.dilewati = { masuk: r.masuk.dilewati, keluar: r.keluar.dilewati, contoh: { masuk: r.masuk.contoh, keluar: r.keluar.contoh } };
      S.sync.waktu = r.waktu || Date.now(); S.sync.pernah = true;
      S.rev++;
      simpan.taruh('bk_cache', { server: S.server, dilewati: S.dilewati, waktu: S.sync.waktu });
    } catch (e) {
      S.sync.galat = e;
      if (!senyap && e.kode !== 'AUTH') toast(e.pesan, 'err');
    } finally {
      S.sync.memuat = false;
      if (S.token) renderSemuaData();
    }
  }

  const simpanPending = () => simpan.taruh('bk_pending', S.pending);
  const simpanCache = () => simpan.taruh('bk_cache', { server: S.server, dilewati: S.dilewati, waktu: S.sync.waktu });

  function upsertServer(tipe, tx) {
    const daftar = tipe === 'in' ? S.server.masuk : S.server.keluar;
    const i = daftar.findIndex((t) => t.r === tx.r);
    if (i >= 0) daftar[i] = tx; else daftar.push(tx);
  }

  /** Kirim transaksi tertunda satu per satu (urut), berhenti bila offline. */
  async function kirimTunda(tampilToast) {
    if (flushing || !S.token || !S.pending.length) return;
    flushing = true;
    let terkirim = 0, ringkasTerakhir = null;
    try {
      while (S.pending.length) {
        const it = S.pending[0];
        try {
          const r = await api('tambah', { tipe: it.tipe, tanggal: it.d, kategori: it.k, nominal: it.n, catatan: it.c, idKlien: it.idKlien });
          S.pending.shift(); upsertServer(it.tipe, r.tx); S.rev++;
          simpanPending(); simpanCache(); terkirim++; ringkasTerakhir = { tipe: it.tipe, n: it.n, k: r.tx.k };
          renderSemuaData();
        } catch (e) {
          if (e.kode === 'JARINGAN' || e.kode === 'RESPON' || e.kode === 'SIBUK') {
            if (tampilToast !== false) toast('Belum terkirim: ' + e.pesan + ' Tersimpan di HP, dicoba lagi otomatis.', 'info', 5000);
            break;
          }
          if (e.kode === 'AUTH') break;
          // galat dari server (mis. sheet tidak ditemukan): buang agar tidak macet, beri tahu
          S.pending.shift(); S.rev++; simpanPending();
          toast('Gagal menyimpan ' + rp(it.n) + ': ' + e.pesan, 'err', 7000);
        }
      }
    } finally {
      flushing = false;
      renderSemuaData();
    }
    if (terkirim && tampilToast !== false) {
      const t = terkirim === 1 && ringkasTerakhir
        ? (ringkasTerakhir.tipe === 'in' ? 'Pemasukan ' : 'Pengeluaran ') + rp(ringkasTerakhir.n) + ' · ' + ringkasTerakhir.k + ' tersimpan di spreadsheet'
        : terkirim + ' transaksi tersimpan di spreadsheet';
      toast(t, 'ok');
    }
  }

  function tambahTransaksi(tx) {
    const it = { idKlien: U.uid(), tipe: tx.tipe, d: tx.d, k: tx.k, n: tx.n, c: tx.c };
    S.pending.push(it); S.rev++; simpanPending();
    simpan.taruh('bk_kat_' + tx.tipe, tx.k);
    renderSemuaData();
    toast('Menyimpan ' + (tx.tipe === 'in' ? 'pemasukan' : 'pengeluaran') + ' ' + rp(tx.n) + '…', 'load');
    kirimTunda(true);
  }

  /* ------------------------------------------------------------------ */
  /*  Tampilan: komponen kecil                                            */
  /* ------------------------------------------------------------------ */
  function chipPeriode() {
    const p = periodeAktif();
    const daftar = [['hari', 'Hari ini'], ['minggu', 'Minggu ini'], ['bulan', 'Bulan ini'], ['kustom', 'Kustom']];
    return '<div class="periode"><div class="chips geser" role="tablist" aria-label="Periode">' +
      daftar.map((d) => '<button class="chip ' + (p.k === d[0] ? 'on' : '') + '" role="tab" aria-selected="' + (p.k === d[0]) + '" data-act="periode" data-v="' + d[0] + '">' + d[1] + '</button>').join('') +
      '</div><div class="periode-label">' + U.rentang(p.dari, p.sampai) + '</div></div>';
  }

  function kosong(judul, isi, tombol) {
    return '<div class="kosong">' + bintang('kosong-bintang', '') +
      '<h3>' + esc(judul) + '</h3><p>' + esc(isi) + '</p>' + (tombol || '') + '</div>';
  }

  function kerangkaMuat() {
    return '<div class="rangka"><div class="sk sk-hero"></div><div class="sk sk-baris"></div><div class="sk sk-baris"></div><div class="sk sk-baris"></div></div>';
  }

  function barisTx(t, opsi) {
    opsi = opsi || {};
    const masuk = t.tipe === 'in';
    return '<button class="tx" data-act="buka" data-id="' + esc(t.id) + '">' +
      '<span class="tx-ikon ' + (masuk ? 'masuk' : 'keluar') + '">' + ikon(masuk ? 'bawah' : 'atas') + '</span>' +
      '<span class="tx-isi"><b>' + esc(t.k) + '</b><small>' + (opsi.tanggal ? U.tglPendek(t.d) + (t.c ? ' · ' : '') : '') + esc(t.c) + '</small></span>' +
      '<span class="tx-nilai"><b>' + (masuk ? '+' : '−') + rp(Math.abs(t.n)) + '</b>' + (t.tunda ? '<small class="tunda">Belum terkirim</small>' : '') + '</span></button>';
  }

  /* ------------------------------------------------------------------ */
  /*  Tampilan: Beranda                                                   */
  /* ------------------------------------------------------------------ */
  function labelBanding(p) {
    return p.k === 'hari' ? 'kemarin' : U.rentang(rentangSebelumnya(p).dari, rentangSebelumnya(p).sampai);
  }

  function banding(nama, cur, prev, p, burukNaik) {
    const lbl = labelBanding(p);
    if (!cur && !prev) return { ikon: 'sama', judul: nama + ': belum ada data', isi: 'Periode ini dan ' + lbl + ' sama-sama kosong.', redup: true };
    if (!prev) return { ikon: 'sama', judul: nama + ' ' + rp(cur), isi: 'Tidak ada data pembanding di ' + lbl + '.' };
    const sel = cur - prev;
    if (sel === 0) return { ikon: 'sama', judul: nama + ' sama dengan periode lalu', isi: 'Sama-sama ' + rp(cur) + ' (' + lbl + ').' };
    const naik = sel > 0;
    return {
      ikon: naik ? 'naik' : 'turun', baik: naik !== burukNaik, buruk: naik === burukNaik,
      judul: nama + (naik ? ' naik ' : ' turun ') + persen(Math.abs(sel / prev * 100)),
      isi: rp(Math.abs(sel)) + (naik ? ' lebih banyak' : ' lebih sedikit') + ' dari ' + lbl + ' (' + rp(prev) + ').'
    };
  }

  function daftarInsight(p, r) {
    const sb = rentangSebelumnya(p), rs = ringkasan(sb.dari, sb.sampai);
    const kat = agregatKategori('out', p.dari, p.sampai);
    const hari = hariBerjalan(p);
    const out = [];
    out.push(kat.length
      ? { ikon: 'tag', judul: 'Pengeluaran terbesar: ' + kat[0].nama, isi: rp(kat[0].nilai) + ' · ' + persen(kat[0].nilai / r.keluar * 100) + ' dari total pengeluaran.' }
      : { ikon: 'tag', judul: 'Belum ada pengeluaran', isi: 'Kategori terbesar muncul setelah kamu mencatat pengeluaran.', redup: true });
    out.push({ ikon: 'kalender', judul: 'Rata-rata ' + rp(r.keluar / hari) + ' per hari', isi: 'Pengeluaran dibagi ' + hari + ' hari berjalan.' });
    out.push(banding('Pengeluaran', r.keluar, rs.keluar, p, true));
    out.push(banding('Pemasukan', r.masuk, rs.masuk, p, false));
    return out;
  }

  function viewBeranda() {
    const semuaTx = semua();
    if (!semuaTx.length && S.sync.memuat && !S.sync.pernah) return '<div class="halaman">' + kerangkaMuat() + '</div>';
    if (!semuaTx.length && !S.sync.pernah && S.sync.galat) {
      return '<div class="halaman">' + kosong('Data belum bisa dimuat', S.sync.galat.pesan, '<button class="btn utama" data-act="segarkan">Coba lagi</button>') + '</div>';
    }
    if (!semuaTx.length) {
      return '<div class="halaman">' + kosong('Belum ada transaksi', 'Catat pemasukan atau pengeluaran pertamamu. Hasilnya langsung masuk ke spreadsheet.', '<button class="btn utama" data-act="tambah">' + ikon('plus') + ' Tambah transaksi</button>') + '</div>';
    }
    const p = periodeAktif(), r = ringkasan(p.dari, p.sampai);
    const total = r.masuk + r.keluar;
    const lebarMasuk = total ? Math.round(r.masuk / total * 100) : 0;
    const nama = S.user ? S.user.charAt(0).toUpperCase() + S.user.slice(1) : '';
    const terbaru = semuaTx.slice().sort(urutTerbaru).slice(0, 5);

    let h = '<div class="halaman">' +
      '<p class="salam">Assalamu’alaikum' + (nama ? ', ' + esc(nama) : '') + '</p>' + chipPeriode() +
      '<section class="hero" aria-label="Ringkasan keuangan">' +
      '<div class="hero-judul">Saldo bersih</div>' +
      '<div class="hero-angka' + (r.saldo < 0 ? ' minus' : '') + '">' + rp(r.saldo) + '</div>' +
      (r.saldo < 0 ? '<div class="hero-catatan">Pengeluaran lebih besar dari pemasukan.</div>' : '') +
      '<div class="rasio" role="img" aria-label="Pemasukan ' + lebarMasuk + ' persen, pengeluaran ' + (total ? 100 - lebarMasuk : 0) + ' persen">' +
      (total ? '<span class="rasio-masuk" style="width:' + lebarMasuk + '%"></span><span class="rasio-keluar"></span>' : '<span class="rasio-kosong"></span>') + '</div>' +
      '<div class="hero-dua">' +
      '<div><span class="hero-ket"><i class="titik masuk"></i>Pemasukan</span><b>' + rp(r.masuk) + '</b><small>' + r.nm + ' transaksi</small></div>' +
      '<div><span class="hero-ket"><i class="titik keluar"></i>Pengeluaran</span><b>' + rp(r.keluar) + '</b><small>' + r.nk + ' transaksi</small></div>' +
      '</div></section>';

    h += '<section class="blok"><h2>Insight periode ini</h2><ul class="insight">' +
      daftarInsight(p, r).map((x) => '<li class="' + (x.redup ? 'redup' : '') + '"><span class="in-ikon ' + (x.baik ? 'baik' : x.buruk ? 'buruk' : '') + '">' + ikon(x.ikon) + '</span>' +
        '<div><b>' + esc(x.judul) + '</b><small>' + esc(x.isi) + '</small></div></li>').join('') + '</ul></section>';

    h += '<section class="blok"><div class="blok-kepala"><h2>Transaksi terbaru</h2><button class="tautan" data-act="tab" data-v="riwayat">Lihat semua</button></div>' +
      '<div class="daftar">' + terbaru.map((t) => barisTx(t, { tanggal: true })).join('') + '</div></section>';

    h += bannerPasang();
    return h + '</div>';
  }

  function bannerPasang() {
    const standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
    if (standalone || S.sembunyiPasang) return '';
    const ios = /iphone|ipad|ipod/i.test(navigator.userAgent);
    if (!S.pasang && !ios) return '';
    return '<section class="pasang"><div><b>Pasang di layar utama</b><small>' +
      (S.pasang ? 'Buka seperti aplikasi biasa, langsung dari ikon di HP.' : 'Ketuk tombol Bagikan di Safari, lalu pilih “Tambah ke Layar Utama”.') + '</small></div>' +
      (S.pasang ? '<button class="btn utama kecil" data-act="pasang">Pasang</button>' : '') +
      '<button class="ikon-btn" data-act="sembunyi-pasang" aria-label="Sembunyikan">' + ikon('x') + '</button></section>';
  }

  /* ------------------------------------------------------------------ */
  /*  Tampilan: Grafik                                                    */
  /* ------------------------------------------------------------------ */
  function bucketHarian(p) {
    const akhir = akhirEfektif(p);
    if (akhir < p.dari) return [];
    const n = U.selisihHari(p.dari, akhir) + 1;
    if (n > 45) return null;
    const jumlah = {};
    semua().forEach((t) => { if (t.tipe === 'out' && t.d >= p.dari && t.d <= akhir) jumlah[t.d] = (jumlah[t.d] || 0) + t.n; });
    const out = [];
    for (let i = 0; i < n; i++) {
      const d = U.tambahHari(p.dari, i), dt = U.dariIso(d);
      out.push({ label: n <= 7 ? U.HARI[dt.getDay()].slice(0, 3) : String(dt.getDate()), nilai: jumlah[d] || 0, tip: U.labelHari(d) + ' · ' + rp(jumlah[d] || 0) });
    }
    return out;
  }

  function bucketBulan(jumlahBulan, bentuk) {
    const peta = perBulan(), awal = U.awalBulan(U.hariIni()), out = [];
    for (let i = jumlahBulan - 1; i >= 0; i--) {
      const m = U.geserBulan(awal, -i), e = peta[m.slice(0, 7)] || { in: 0, out: 0 };
      const dt = U.dariIso(m);
      const label = U.BLN[dt.getMonth()];
      if (bentuk === 'tren') out.push({ label, nilai: e.out, tip: U.namaBulan(m) + ' · ' + rp(e.out) });
      else out.push({ label, a: e.in, b: e.out, tip: U.namaBulan(m) + ' — masuk ' + rp(e.in) + ' · keluar ' + rp(e.out) + ' · selisih ' + rpTanda(e.in - e.out) });
    }
    return out;
  }

  function viewGrafik() {
    if (!semua().length) {
      return '<div class="halaman"><h1 class="judul">Grafik</h1>' + (S.sync.memuat && !S.sync.pernah ? kerangkaMuat() : kosong('Belum ada data untuk digrafikkan', 'Grafik muncul setelah ada transaksi.', '<button class="btn utama" data-act="tambah">' + ikon('plus') + ' Tambah transaksi</button>')) + '</div>';
    }
    const p = periodeAktif(), r = ringkasan(p.dari, p.sampai);
    let h = '<div class="halaman"><h1 class="judul">Grafik</h1>' + chipPeriode();

    // 1. Kategori
    const kat = agregatKategori('out', p.dari, p.sampai);
    h += '<section class="kartu"><h2>Pengeluaran per kategori</h2>';
    if (!kat.length) {
      h += '<p class="redup-teks">Belum ada pengeluaran di periode ini.</p>';
    } else {
      const warna = warnaKategori(kat);
      let irisan = kat.slice(0, 6).map((e) => ({ nama: e.nama, nilai: e.nilai, warna: warna(e.kunci) }));
      if (kat.length > 6) {
        const sisa = kat.slice(6);
        irisan.push({ nama: 'Lainnya (' + sisa.length + ' kategori)', nilai: sisa.reduce((a, e) => a + e.nilai, 0), warna: G.WARNA_LAIN });
      }
      S.chart.donat = irisan.map((x) => Object.assign({ persen: x.nilai / r.keluar * 100 }, x));
      h += '<div class="donat-wadah" data-chart="donat">' + G.donat(irisan, r.keluar, pusatDonat('Total', ringkas(r.keluar))) + '</div>' +
        '<ul class="legenda">' + S.chart.donat.map((x, i) => '<li><button data-act="fokus-kat" data-i="' + i + '"><i class="kotak" style="background:' + x.warna + '"></i><span class="lg-nama">' + esc(x.nama) +
          '</span><span class="lg-persen">' + persen(x.persen) + '</span><span class="lg-nilai">' + rp(x.nilai) + '</span></button></li>').join('') + '</ul>';
    }
    h += '</section>';

    // 2. Tren
    const harian = bucketHarian(p);
    const mode = harian === null ? 'bulanan' : S.tren;
    const dataTren = mode === 'harian' ? harian : bucketBulan(12, 'tren');
    S.chart.tren = dataTren;
    const jml = dataTren.reduce((a, b) => a + b.nilai, 0);
    let pertama = dataTren.findIndex((b) => b.nilai > 0); if (pertama < 0) pertama = 0;
    const rata = dataTren.length ? jml / (mode === 'harian' ? dataTren.length : Math.max(1, dataTren.length - pertama)) : 0;
    S.chart.trenBaca = 'Total ' + rp(jml) + ' · rata-rata ' + rp(rata) + (mode === 'harian' ? ' per hari' : ' per bulan');
    h += '<section class="kartu"><div class="kartu-kepala"><h2>Tren pengeluaran</h2><div class="seg kecil">' +
      '<button class="' + (mode === 'harian' ? 'on' : '') + '" data-act="tren" data-v="harian"' + (harian === null ? ' disabled title="Periode terlalu panjang untuk tampilan harian"' : '') + '>Harian</button>' +
