  async function kirimMasuk() {
    if (S.memuatMasuk) return;
    const pin = S.modeMasuk === 'pin';
    const isi = pin ? { pin: ($('#m-pin') || {}).value || '' } : { username: ($('#m-user') || {}).value || '', password: ($('#m-pass') || {}).value || '' };
    if (pin ? !/^\d{6}$/.test(isi.pin) : !isi.username.trim() || !isi.password) {
      S.galatMasuk = pin ? 'Masukkan PIN 6 angka.' : 'Isi username dan kata sandi.'; render(); return;
    }
    S.userDraft = isi.username || '';
    S.memuatMasuk = true; S.galatMasuk = ''; render();
    try {
      const r = await api('login', isi);
      S.token = r.token; S.user = r.user;
      simpan.taruh('bk_token', r.token); simpan.taruh('bk_user', r.user);
      if (!pin) simpan.taruh('bk_username', isi.username.trim());
      S.memuatMasuk = false; S.tab = 'beranda';
      render();
