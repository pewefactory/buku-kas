/* Service worker: menyimpan berkas aplikasi di HP supaya terbuka cepat dan tetap bisa dibuka tanpa internet.
 * Data keuangan TIDAK disimpan di sini (permintaan ke Apps Script tidak disentuh sama sekali).
 * Setiap kali kamu mengunggah versi baru aplikasi, naikkan angka VERSI di bawah ini. */
const VERSI = 'bukukas-v1';
const BERKAS = [
  './', 'index.html', 'style.css', 'config.js', 'util.js', 'charts.js', 'app.js',
  'manifest.webmanifest', 'fonts/plus-jakarta-sans.woff2',
  'icons/icon-192.png', 'icons/icon-512.png', 'icons/apple-touch-icon.png'
];

self.addEventListener('install', (e) => {
  e.waitUntil(caches.open(VERSI).then((c) => c.addAll(BERKAS)).then(() => self.skipWaiting()));
});

self.addEventListener('activate', (e) => {
  e.waitUntil(
    caches.keys().then((ks) => Promise.all(ks.filter((k) => k !== VERSI).map((k) => caches.delete(k)))).then(() => self.clients.claim())
  );
});

self.addEventListener('fetch', (e) => {
  const req = e.request;
  const url = new URL(req.url);
  if (req.method !== 'GET' || url.origin !== self.location.origin) return;   // API Google dibiarkan lewat
  // Tampilkan dari simpanan dulu (cepat), sambil memperbarui di belakang layar.
  e.respondWith(
    caches.open(VERSI).then((cache) =>
      cache.match(req, { ignoreSearch: true }).then((tersimpan) => {
        const dariJaringan = fetch(req).then((res) => {
          if (res && res.ok) cache.put(req, res.clone());
          return res;
        }).catch(() => tersimpan);
        return tersimpan || dariJaringan;
      })
    )
  );
});

/* Alat bantu: format Rupiah, tanggal, penyimpanan lokal. Tidak ada hubungannya dengan tampilan. */
(function () {
  const pad = (n) => String(n).padStart(2, '0');
  const BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  const BLN = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  const HARI = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];

  const iso = (d) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
  const dariIso = (s) => { const p = s.split('-').map(Number); return new Date(p[0], p[1] - 1, p[2]); };
  const hariIni = () => iso(new Date());
  const tambahHari = (s, n) => { const d = dariIso(s); d.setDate(d.getDate() + n); return iso(d); };
  const selisihHari = (a, b) => Math.round((dariIso(b) - dariIso(a)) / 864e5);
  const awalBulan = (s) => { const d = dariIso(s); return iso(new Date(d.getFullYear(), d.getMonth(), 1)); };
  const akhirBulan = (s) => { const d = dariIso(s); return iso(new Date(d.getFullYear(), d.getMonth() + 1, 0)); };
  const geserBulan = (s, n) => { const d = dariIso(s); return iso(new Date(d.getFullYear(), d.getMonth() + n, 1)); };

  const tglPendek = (s) => { const d = dariIso(s); return d.getDate() + ' ' + BLN[d.getMonth()]; };
  const tglPanjang = (s) => { const d = dariIso(s); return d.getDate() + ' ' + BLN[d.getMonth()] + ' ' + d.getFullYear(); };
  const rentang = (a, b) => {
    if (a === b) return tglPanjang(a);
    const da = dariIso(a), db = dariIso(b);
    if (da.getFullYear() === db.getFullYear() && da.getMonth() === db.getMonth()) return da.getDate() + '–' + db.getDate() + ' ' + BLN[db.getMonth()] + ' ' + db.getFullYear();
    if (da.getFullYear() === db.getFullYear()) return tglPendek(a) + ' – ' + tglPanjang(b);
    return tglPanjang(a) + ' – ' + tglPanjang(b);
  };
  const labelHari = (s) => {
    const t = hariIni();
    if (s === t) return 'Hari ini';
    if (s === tambahHari(t, -1)) return 'Kemarin';
    const d = dariIso(s);
    return HARI[d.getDay()] + ', ' + tglPanjang(s);
  };
  const namaBulan = (s) => { const d = dariIso(s); return BULAN[d.getMonth()] + ' ' + d.getFullYear(); };

  const ribuan = (n) => String(Math.abs(Math.round(n))).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  const rp = (n) => (n < 0 ? '-' : '') + 'Rp ' + ribuan(n);
  const rpTanda = (n) => (n < 0 ? '−' : '+') + 'Rp ' + ribuan(n);
  const koma = (x) => String(x).replace('.', ',');
  const ringkas = (n) => {
    const a = Math.abs(n), t = n < 0 ? '-' : '';
    if (a >= 1e9) return t + koma(+(a / 1e9).toFixed(1)) + ' M';
    if (a >= 1e6) return t + koma(+(a / 1e6).toFixed(1)) + ' jt';
    if (a >= 1e3) return t + koma(+(a / 1e3).toFixed(a >= 1e5 ? 0 : 1)) + ' rb';
    return t + Math.round(a);
  };
  const persen = (x) => koma(+x.toFixed(x >= 10 ? 0 : 1)) + '%';

  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const simpan = {
    ambil(k, awal) { try { const v = localStorage.getItem(k); return v == null ? awal : JSON.parse(v); } catch (e) { return awal; } },
    taruh(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { /* penyimpanan penuh / diblokir */ } },
    hapus(k) { try { localStorage.removeItem(k); } catch (e) { /* abaikan */ } }
  };

  const uid = () => (Date.now().toString(36) + Math.random().toString(36).slice(2, 10)).slice(0, 24);

  window.U = { pad, BULAN, BLN, HARI, iso, dariIso, hariIni, tambahHari, selisihHari, awalBulan, akhirBulan, geserBulan, tglPendek, tglPanjang, rentang, labelHari, namaBulan, ribuan, rp, rpTanda, ringkas, persen, esc, simpan, uid };
})();

